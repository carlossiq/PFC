# ===== DATABASE =====
# Local (desenvolvimento com Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pfc_db

# ===== APPLICATION =====
APP_NAME=Technology Prospecting API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
# Ecoa toda query SQL no log (uma linha por SELECT/INSERT/...) - só pra
# depurar uma query específica, deixe False no dia a dia (era o principal
# motivo do log de inicialização/requests ficar poluído).
SQL_ECHO=False

# ===== SERVER =====
HOST=0.0.0.0
PORT=8000

# ===== API =====
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===== SECURITY =====
SECRET_KEY=65E3ifwj_6WAL3FBVmOIpg4axw656GNbEOqYTJdx-cg
ALGORITHM=HS256

# ===== FEATURE FLAGS DE API =====
# Únicas variáveis de "escolha de API" que continuam sempre lidas do .env
# (não migraram pro banco) - services/llm/field_schema_service.py as usa em
# toda requisição pra decidir quais campos (TITLE/IPC/CPC/AUTHORS/...) o
# prompt da IA considera disponíveis pra busca final. OPS_ENABLED e
# SCOPUS_ENABLED têm um segundo papel: só na primeira subida (banco vazio),
# decidem qual API cada família (patente/artigo) começa ativa em
# search_api_selection - depois disso, quem manda é a tela Configurações >
# Busca do front, não mais essas flags.
LENS_PATENT_ENABLED=True
LENS_SCHOLARLY_ENABLED=True
OPS_ENABLED=True
SCOPUS_ENABLED=True
LENS_ENABLED=True

# ===== MINIO (armazenamento dos gráficos gerados) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=session-charts
MINIO_SECURE=False

# ===== CHROMADB (container chromadb/chroma do docker-compose.yml) =====
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ===== COMPILADOR DE PDF (container latex-compiler) =====
# Só usado sob demanda (POST /report/{session_id}/compile-pdf)
LATEX_COMPILER_URL=http://localhost:8090

# =====================================================================
# SEED INICIAL - só usado se as tabelas de configuração ainda estiverem
# vazias (primeira subida do backend contra um banco novo). Depois disso,
# TUDO abaixo passa a ser editável pela tela Configurações do front (ou via
# API - ver app/adapters/driving/http/config_router.py) e o banco vira a
# fonte de verdade - reeditar essas linhas aqui não faz mais nada.
#
# Referência completa dos ~30 campos migrados (o que cada um faz, valor
# recomendado): VARIAVEIS_DE_CONFIGURACAO.md. Desenho da migração:
# PLANO_MIGRACAO_CONFIG_BANCO.md.
# =====================================================================

# --- IA (vira llm_provider_configs + llm_call_site_bindings) ---
LLM_PROVIDER=mock
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash-exp
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-haiku-4-5

# --- Relatório LaTeX / RAG (vira llm_provider_configs, provider "ollama") ---
# Local (dev): container ollama do docker-compose.yml, sem API key.
# Intranet: endpoint remoto compatível com OpenAI (Bearer token) - preencher
# só no seu .env local, nunca commitar o valor real aqui.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Credenciais de API externa (viram app_settings, categoria external_api) ---
LENS_API_TOKEN=
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
SCOPUS_API_KEY=

# --- Demais escalares (viram app_settings - ver VARIAVEIS_DE_CONFIGURACAO.md) ---
TEST_MODE=False
LLM_KEYBERT_MODEL=distiluse-base-multilingual-cased-v2
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
RAG_TOP_K_PER_SECTION=5
SEARCH_YEAR_FROM=2015
SEARCH_YEAR_TO=2026
PROBE_TOP_K=10
FINAL_TOP_K=100
# Relevância, extração de termos (13 campos), fuzzy matching e inferência
# estatística (~20 campos no total) usam os defaults hardcoded em
# core/config.py se não forem setados aqui - só vale a pena listar aqui se
# você quiser um valor inicial diferente do default já embutido no código.
