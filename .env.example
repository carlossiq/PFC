# Application Configuration
APP_NAME=Technology Prospecting API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Security (placeholder for future use)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# LLM Configuration
LLM_PROVIDER=gemini
TEST_MODE=false

# Gemini API Configuration
LLM_GEMINI_API_KEY=your-gemini-api-key-here
LLM_GEMINI_MODEL=gemini-3.1-pro

# Anthropic API Configuration
LLM_ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# External APIs Configuration
# Lens API
LENS_API_TOKEN=your-lens-api-token-here

# OPS API (OAuth2)
OPS_CONSUMER_KEY=your-ops-consumer-key-here
OPS_CONSUMER_SECRET=your-ops-consumer-secret-here

# Scopus API
SCOPUS_API_KEY=your-scopus-api-key-here

# NLP and Relevance Configuration
RELEVANCE_THRESHOLD=0.5

# Search Configuration
SEARCH_YEAR_FROM=2015
SEARCH_YEAR_TO=2026
PROBE_API=lens_patent
# PROBE_API_EXT=lens_scholarly (optional: enables secondary probe search)
PROBE_TOP_K=10
FINAL_TOP_K=100

# Feature Flags (enable/disable specific APIs for final search)
LENS_PATENT_ENABLED=true
LENS_SCHOLARLY_ENABLED=true
OPS_ENABLED=true
SCOPUS_ENABLED=true

# Retrocompatibilidade: LENS_ENABLED ativa ambas lens_patent e lens_scholarly
LENS_ENABLED=true
