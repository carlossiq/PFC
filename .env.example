# ChromaDB (container chromadb/chroma do docker-compose.yml)
CHROMA_HOST=localhost
CHROMA_PORT=8001
RAG_TOP_K_PER_SECTION=5

# Compilador de PDF (container latex-compiler do docker-compose.yml) - só
# usado sob demanda (POST /report/{session_id}/compile-pdf)
LATEX_COMPILER_URL=http://localhost:8090

# ===== FEATURE FLAGS =====
LENS_PATENT_ENABLED=True
LENS_SCHOLARLY_ENABLED=True
OPS_ENABLED=True
SCOPUS_ENABLED=True
LENS_ENABLED=True
