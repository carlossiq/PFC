# ===== DATABASE =====
# Local (desenvolvimento com Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pfc_db

# ===== APPLICATION =====
APP_NAME=Technology Prospecting API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===== SERVER =====
HOST=0.0.0.0
PORT=8000

# ===== API =====
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===== SECURITY =====
SECRET_KEY=65E3ifwj_6WAL3FBVmOIpg4axw656GNbEOqYTJdx-cg
ALGORITHM=HS256

# ===== LLM CONFIGURATION =====
LLM_PROVIDER=mock
TEST_MODE=False
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash-exp
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== EXTERNAL APIs =====
LENS_API_TOKEN=
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
SCOPUS_API_KEY=

# ===== SEARCH CONFIGURATION =====
SEARCH_YEAR_FROM=2015
SEARCH_YEAR_TO=2026
PROBE_API=lens_patent
PROBE_API_EXT=
PROBE_TOP_K=10
FINAL_TOP_K=100

# ===== MINIO (armazenamento dos gráficos gerados) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=session-charts
MINIO_SECURE=False

# ===== RELATÓRIO LATEX (RAG local + LLM) =====
# Local (dev): container ollama do docker-compose.yml, sem API key.
# Intranet: endpoint remoto compatível com OpenAI (Bearer token) - preencher
# só no seu .env local, nunca commitar o valor real aqui.

## LOCAL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_REQUEST_TIMEOUT_SECONDS= 300

## IME
#  qwen3-vl:32b ou gemma4:12b para o IME
#OLLAMA_BASE_URL=http://192.168.90.50:4000
