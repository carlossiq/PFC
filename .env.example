# ===================================================================
# Copie para .env (cp .env.example .env) e preencha só as credenciais
# marcadas como "PREENCHER". Todo o resto já funciona com o docker-compose.
#
# Este arquivo guarda só infraestrutura, flags e credenciais. Os parâmetros
# de comportamento (busca, extração de termos, IA, relatório) têm padrão no
# código e são gravados no banco na primeira subida; altere-os pela tela
# Configurações. Referência: docs/manuais/02_manual_configuracao.md
# ===================================================================

# ===== DATABASE (container postgres do docker-compose.yml) =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pfc_db

# ===== APPLICATION =====
APP_NAME=Technology Prospecting API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
# Ecoa toda query SQL no log - só pra depurar uma query específica.
SQL_ECHO=False

# ===== API =====
API_PREFIX=/api/v1
# Lista em JSON (o pydantic-settings não aceita vírgula aqui)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ===== FEATURE FLAGS DE API =====
# Na primeira subida (banco vazio), definem qual API de cada família começa
# ativa. Depois disso, a escolha é feita na tela Configurações > Busca.
LENS_PATENT_ENABLED=True
LENS_SCHOLARLY_ENABLED=True
OPS_ENABLED=True
SCOPUS_ENABLED=True
LENS_ENABLED=True

# ===== MINIO (container minio - armazenamento dos gráficos e da capa) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=session-charts
MINIO_SECURE=False

# ===== CHROMADB (container chromadb - vector store do RAG) =====
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ===== COMPILADOR DE PDF E REVISÃO DE LÍNGUA =====
LATEX_COMPILER_URL=http://localhost:8090
LANGUAGETOOL_URL=http://localhost:8010

# ===== IA: ENDPOINT LOCAL / INTRANET =====
# Container ollama local por padrão. Para a intranet, troque a URL e preencha
# a chave (Bearer token) só no seu .env. O provedor e o modelo são escolhidos
# na tela Configurações > Inteligência Artificial.
# Antes de usar, baixe o modelo: docker exec -it pfc_ollama ollama pull qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# PREENCHER só se o endpoint exigir token
OLLAMA_API_KEY=

# ===== IA: CHAVES DE PROVEDORES EXTERNOS =====
# PREENCHER se for usar Gemini (ver Configurações > Inteligência Artificial)
LLM_GEMINI_API_KEY=
# PREENCHER se for usar Anthropic
LLM_ANTHROPIC_API_KEY=

# =====================================================================
# BUSCA EM BASES EXTERNAS
# Sem pelo menos uma credencial de patente e uma de artigo, a busca
# retorna vazia (o app sobe, mas não encontra nada). As chaves são
# pessoais e não vão no repositório.
# Patente padrão: OPS (OPS_*). Artigo padrão: Scopus (SCOPUS_API_KEY).
# Lens (LENS_API_TOKEN) é alternativa para as duas famílias.
# =====================================================================
# PREENCHER (Lens - patentes e artigos)
LENS_API_TOKEN=
# PREENCHER (OPS - European Patent Office)
OPS_CONSUMER_KEY=
# PREENCHER (OPS)
OPS_CONSUMER_SECRET=
# PREENCHER (Scopus - artigos)
SCOPUS_API_KEY=
