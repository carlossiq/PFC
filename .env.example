# Application Configuration
APP_NAME=Technology Prospecting API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration (placeholder for future use)
DATABASE_URL=sqlite:///./app.db

# Security (placeholder for future use)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# LLM Configuration
LLM_PROVIDER=mock
TEST_MODE=false
# LLM_GEMINI_API_KEY=your-gemini-api-key
# LLM_ANTHROPIC_API_KEY=your-anthropic-api-key

# External APIs Configuration
# Lens API
# LENS_API_TOKEN=your-lens-api-token

# OPS API (OAuth2)
# OPS_CONSUMER_KEY=your-ops-consumer-key
# OPS_CONSUMER_SECRET=your-ops-consumer-secret

# Scopus API
# SCOPUS_API_KEY=your-scopus-api-key

# NLP and Relevance Configuration
RELEVANCE_THRESHOLD=0.5

# Search Configuration
SEARCH_YEAR_FROM=2015
SEARCH_YEAR_TO=2024
PROBE_API=lens_patent
# PROBE_API_EXT=lens_scholarly
